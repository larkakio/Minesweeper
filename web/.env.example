# Site (production: your Vercel URL — fixes OG/metadataBase; local dev defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Chain (Base mainnet)
NEXT_PUBLIC_CHAIN_ID=8453

# Daily check-in contract (deploy contracts/ then paste address)
NEXT_PUBLIC_CHECK_IN_CONTRACT_ADDRESS=0x

# Base.dev project (meta base:app_id + dashboard)
NEXT_PUBLIC_BASE_APP_ID=your-base-dev-app-id

# Builder code from base.dev → Settings → Builder Code (bc_…)
NEXT_PUBLIC_BUILDER_CODE=

# Rare override: raw 0x suffix instead of deriving from NEXT_PUBLIC_BUILDER_CODE
# NEXT_PUBLIC_BUILDER_CODE_SUFFIX=0x

# Optional WalletConnect (not installed by default in this template)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
